---
import { siteConfig } from '../../lib/config';

// 章节内翻页（作者指定）：6 张卡按每屏 2 张切成 3 个子屏，
// 每个子屏是一“硬切”单位；翻完子屏才进下一章。卡片数比一屏高时，
// 不再靠屏内自由滚动，而是像 PPT 一样一屏一屏翻。
const PER_PAGE = 2;
const pages: typeof siteConfig.projects[] = [];
for (let i = 0; i < siteConfig.projects.length; i += PER_PAGE) {
  pages.push(siteConfig.projects.slice(i, i + PER_PAGE));
}
---

<section id="projects">
  <div class="container">
    <h2 class="section-title">
      <span class="num text-pixel">02</span><span class="text-pixel">PROJECTS</span> <span class="text-dim">作品集</span>
    </h2>

    <div class="subpages">
      {
        pages.map((page, pi) => (
          <ul class="proj-page" data-page={pi}>
            {page.map((project) => (
              <li class="pixel-panel card">
                <h3 class="text-pixel name">{project.name}</h3>
                <p class="desc">{project.description}</p>
                <p class="tags">
                  {project.tags.map((tag) => (
                    <span class="tag text-pixel">{tag}</span>
                  ))}
                </p>
                {project.url && (
                  <a class="pixel-btn" href={project.url} data-sfx-role="click">
                    VIEW
                  </a>
                )}
              </li>
            ))}
          </ul>
        ))
      }
    </div>

    <div class="proj-pager" aria-hidden="true">
      {pages.map((_, pi) => <span class="dot" data-i={pi}></span>)}
    </div>
  </div>
</section>

<style>
  /* 默认（无 JS / 内容可访问性）：3 个子屏全部平铺显示，一张卡都不丢。
     子屏分页是“增强”，由 index.astro 加 .is-paged 后才启用——与全站
     「仅 JS 加类，无 JS 时内容默认可见」的约定一致。 */
  .subpages {
    min-height: 0;
  }

  .proj-page {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .proj-pager {
    display: none;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 1.4rem;
  }

  /* 有 JS：切成分页模式——同一时刻只显示激活子屏，卡片由 WAAPI 点亮 */
  .subpages.is-paged .proj-page {
    display: none;
  }
  .subpages.is-paged .proj-page.is-active {
    display: grid;
  }
  .subpages.is-paged .proj-page .pixel-panel.card {
    opacity: 0;
  }
  .proj-pager.is-paged {
    display: flex;
  }
  .dot {
    width: 10px;
    height: 10px;
    background: var(--gb-1);
    /* 像素方块，不做圆角 */
    transition: background 0.12s steps(2);
  }
  .dot.is-active {
    background: var(--gb-2);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.1s steps(2), box-shadow 0.1s steps(2);
  }

  .card:hover {
    transform: translate(-2px, -2px);
    box-shadow:
      inset 4px 4px 0 color-mix(in srgb, var(--gb-3) 10%, transparent),
      6px 6px 0 color-mix(in srgb, var(--gb-1) 70%, transparent);
  }

  .name {
    font-size: 0.9rem;
    color: var(--gb-3);
    margin: 0;
    /* 竖直让开左上角焊盘（面板 padding 24px 起始 28px，焊盘占 24–40px）；
       仅标题下沉、desc/tags 不动，避免左缩进错位 */
    padding-top: calc(var(--step) * 4);
    padding-right: 1.25rem;
  }

  /* 描述压暗：卡片焦点回到项目名（丝印「标题→说明」层级） */
  .desc {
    color: var(--color-text-dim);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .card .pixel-btn {
    align-self: flex-start;
    font-size: 0.6rem;
    padding: 0.45rem 0.8rem;
  }
</style>
