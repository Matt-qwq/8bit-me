---
import { siteConfig } from '../../lib/config';

// 6 卡网格（A6）：章节内子屏/分页器已随 fullpage 骨架退役（2026-09 方案
// home-scroll-reveal-redesign），卡片由 index.astro 的统一编排
// （标题先行 → 卡片 stagger 浮入，reveal-motion.ts）依次揭示。
// 无 JS = 网格平铺可见（仅 JS 加 reveal-card，与全站纪律一致）。
---

<section id="projects">
  <div class="container">
    <h2 class="section-title">
      <span class="num text-pixel">02</span><span class="text-pixel">PROJECTS</span> <span class="text-dim">作品集</span>
    </h2>

    <ul class="proj-grid">
      {
        siteConfig.projects.map((project) => (
          <li class="pixel-panel card">
            <h3 class="text-pixel name">{project.name}</h3>
            <p class="desc">{project.description}</p>
            <p class="tags">
              {project.tags.map((tag) => (
                <span class="tag text-pixel">{tag}</span>
              ))}
            </p>
            {/* 动作位：无论项目有没有外链都占位——否则同一行里
                「有 VIEW」与「没 VIEW」的卡，tags 会落到两个高度（实测差 14px）。 */}
            <div class="actions">
              {project.url && (
                <a class="pixel-btn" href={project.url} data-sfx-role="click">
                  VIEW
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.1s steps(2), box-shadow 0.1s steps(2);
  }

  .card:hover {
    transform: translate(-2px, -2px);
    box-shadow:
      inset 4px 4px 0 color-mix(in srgb, var(--c-text) 10%, transparent),
      6px 6px 0 color-mix(in srgb, var(--c-line) 70%, transparent);
  }

  .name {
    font-size: 0.875rem;
    letter-spacing: var(--ls-14);
    line-height: 20px;
    color: var(--c-text);
    margin: 0;
    /* 竖直让开左上角焊盘（面板 padding 24px 起始 28px，焊盘占 24–40px）；
       仅标题下沉、desc/tags 不动，避免左缩进错位 */
    padding-top: calc(var(--step) * 4);
    padding-right: 1.25rem;
  }

  /* 描述压暗：卡片焦点回到项目名（丝印「标题→说明」层级） */
  .desc {
    /* 次级文字（同 blog 列表卡）：dim 达标 + 亮度分层 + 行高 24px 可读 */
    color: var(--color-text-dim);
    font-size: 0.875rem;
    letter-spacing: normal;
    line-height: 24px;
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .card .pixel-btn {
    align-self: flex-start;
    font-size: 0.75rem; /* 行高/字距沿用 .pixel-btn（1.4 / 0.08em tracking） */
    padding: 0.45rem 0.8rem;
  }

  /* 动作位固定高度 = 按钮高（2.25rem）：没外链的卡也占这一行，
     同一行的 tags / 按钮才会对到同一条基线。 */
  .actions {
    display: flex;
    align-items: flex-start;
    min-height: 2.25rem;
  }
</style>
