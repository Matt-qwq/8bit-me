---
import CrtTerminal from '../CrtTerminal.astro';
import { siteConfig, siteWeather, url } from '../../lib/config';
import { getPublishedPosts, formatDate } from '../../lib/posts';

/** 站况读数：构建期静态算出，零运行时、零新依赖。
    数据源与 /blog 列表、/blog/tags 同一来源（不可能漂移）。 */
const posts = await getPublishedPosts();
const latest = posts[0];
const status = [
  { k: 'POSTS', v: `${posts.length} 篇` },
  { k: 'UPDATE', v: latest ? formatDate(latest.data.date) : '—' },
];
---

<section id="hero" class="hero">
  <div class="container">
    <div class="hero-inner">
      {/* 工位静物层（T10「窗边工位」）：CRT 屏里是一台正在打字的终端
          （CrtTerminal，代码生成零图片，作者 2026-10-02 终局裁决），「Press START」
          收进屏下 bezel 作一行丝印。几何由脚本从 deskSpec 写进 CSS 变量
          （--crt-screen-*），桌面档固定到视口、与 canvas 的工位同坐标。 */}
      <div class="hero-scene">
        <div class="crt-avatar"><CrtTerminal /></div>
        <p class="text-pixel kicker crt-label">Press START</p>
      </div>
      <div class="hero-text">
        {/* data-tw-line = 打字机作用范围的**唯一载体**（契约单测读这两个属性）：
            h1 + tagline + intro 三行。kicker / CTA / 站况读数不打 ——
            读数是**要紧数据**，延迟它违反「绝不延迟内容」（见 ADR-0017）。
            2026-09-11 作者反馈：「只有上面在打字，下面不打字，很突兀」→
            intro 纳入范围，同时把节奏从 58ms/字 调到 32ms/字（否则三行要 3.9s）。 */}
        <h1 data-tw-line>{siteConfig.title}</h1>
        <p class="tagline text-pixel" data-tw-line>{siteConfig.tagline}</p>
        <p class="intro" data-tw-line>
          {siteConfig.author} 的工程复盘站：做过的项目、踩过的坑、
          沉淀下来的做法，都在这里。
        </p>
        {/* 打字机光标（模板里就渲染好，只为拿到 Astro 的 scoped 样式属性 ——
            运行时 createElement 造的元素拿不到 data-astro-cid，样式会静默不生效）。
            默认 hidden：无 JS 时永不可见；脚本接管后才显示，打完又藏回去。 */}
        <div class="tw-caret" aria-hidden="true" hidden></div>
      </div>
      {/* 三盘卡带（T10）：href / sfx 属性原样保留，只是从横排按钮改成 DOM 卡带，
          立在桌面上（x = deskSpec.cartXs，底边 = 桌沿）。卡带本体是 DOM，
          canvas 那三处只留锚点空位（T8 没画本体）。窄屏回退成既有横排按钮。 */}
      <nav class="hero-cta hero-carts" aria-label="首屏快捷入口">
        <a class="pixel-btn cart" href="#projects" data-sfx-role="nav" data-sfx-hover><span>作品集</span></a>
        <a class="pixel-btn cart cart--primary" href={url('blog')} data-sfx-role="nav" data-sfx-hover><span>阅读博客</span></a>
        <a class="pixel-btn cart" href="https://github.com/Matt-qwq" target="_blank" rel="noopener noreferrer" data-sfx-role="click" data-sfx-hover><span>GitHub</span></a>
      </nav>
      {/* 站况读数（丝印语言，非正文）：告诉首次到访的人「这里有真东西」，
           数据全部来自 getPublishedPosts / THEMES，不手写。 */}
      <dl class="hero-status">
        {status.map((s) => (
          <div class="hero-status__row">
            <dt class="text-pixel">{s.k}</dt>
            <dd>{s.v}</dd>
          </div>
        ))}
      </dl>
      {/* 实况读数（ADR-0020「窗外」的仪表）：作者城市本地时刻 + 实时天气。
           它是「世界叙事」的解释器——访客一眼明白「这是某人窗外真实的世界」。
           静态壳先渲染占位，JS 接管后填时刻与天气词（无 JS 时保持占位不破版）。 */}
      <p class="hero-live text-pixel">
        <span data-live-time>LOCAL --:--</span> · {siteWeather.label} · <span data-live-wx>CLEAR</span>
      </p>
    </div>
  </div>
  {/* 窄屏滚动提示（2026-10-29）：390×844 实测 hero 内容到 680px 结束、下面 163px 是空的，
      访客看不到「页面还很长」。只在 ≤560px 显示——桌面档内容本来就占满一屏，加了是噪声。
      装饰性质 → aria-hidden。 */}
  <p class="hero-scroll text-pixel" aria-hidden="true">SCROLL <span class="hero-scroll__arrow">↓</span></p>
</section>

{/* 打字机预挂载（is:inline：必须紧跟标记、在首帧前把三行裁掉，防 FOUC）。
    ① 解析期就把三行裁掉 → 不存在「先显示全字再跳回空白」的闪烁；
    ② 3s 兜底：模块脚本没接管（chunk 404 / 被拦）就自己揭幕，文字不可能永久隐藏；
    ③ bfcache 恢复：往返导航回来时模块不会重跑，这里负责把裁切清干净。
    clip-path 不进布局（不参与尺寸计算），故裁掉后布局与静态版逐像素一致。 */}
<script is:inline>
  (() => {
    // 桌面工位布局的「首次上坐标」由模块脚本完成（要 import deskSpec）；
    // 它跑之前先藏住 hero 内容，避免「居中栈 → 工位」的一帧跳位。
    // 1.2s 兜底：模块没跑到（chunk 404 / 被拦）就自己揭幕，内容不可能永久隐藏。
    const hero = document.getElementById('hero');
    if (hero) {
      hero.classList.add('hero--boot');
      setTimeout(() => hero.classList.remove('hero--boot'), 1200);
    }
    const lines = document.querySelectorAll('#hero [data-tw-line]');
    if (!lines.length) return;
    const clear = () => {
      lines.forEach((el) => el.style.removeProperty('clip-path'));
      const caret = document.querySelector('#hero .tw-caret');
      if (caret) caret.hidden = true;
    };
    // 不支持 clip-path 就不裁（老引擎走静态显示，零风险）
    if (!window.CSS || !CSS.supports('clip-path', 'polygon(0 0, 0 0, 0 0)')) return;
    lines.forEach((el) => el.style.setProperty('clip-path', 'inset(0 100% 0 0)'));
    // 3s 兜底：模块没跑到接管态（chunk 404 / 中途抛错 / 被拦）就自己揭幕。
    // 注意判据是 'on'/'done' 两个都算接管：打字机现在**等这一章进视口才打**
    //（ADR-0027），若只认 'done'，首屏那三秒一到就会把还没开始打的字揭幕。
    setTimeout(() => {
      const tw = document.documentElement.dataset.tw;
      if (tw !== 'on' && tw !== 'done') clear();
    }, 3000);
    addEventListener('pageshow', (e) => {
      if (e.persisted) clear();
    });
  })();
</script>

{/* 工位坐标接线（T10）：**唯一数据源 = desk-room / window-room 两个纯函数模块**。
    这里只把模块算出的几何写进 #hero 的 CSS 变量，CSS 里不再重复推导像素常量。
    坐标系：deskSpec(w,h) 的 w/h = canvas 逻辑宽高（= .bgfx-canvas 的 rect，
    不含滚动条），与 BgFx 的 getSize() 同一坐标系；固定定位层用视口坐标，
    所以 DOM 与 canvas 画的工位逐像素对齐（窄屏 deskSpec 返 null → 走居中栈）。 */}
<script>
  import { deskSpec } from '../../lib/desk-room';
  import { DARK } from '../../lib/themes';

  const hero = document.getElementById('hero');
  if (hero) {
    const carts = Array.from(hero.querySelectorAll<HTMLElement>('.hero-carts .cart'));

    /** 工位几何 → CSS 变量 */
    const apply = () => {
      const wrap = document.querySelector<HTMLElement>('.bgfx-canvas');
      const cr = wrap?.getBoundingClientRect();
      const w = Math.max(1, Math.round(cr?.width ?? window.innerWidth));
      const h = Math.max(1, Math.round(cr?.height ?? window.innerHeight));
      const d = deskSpec(w, h);
      const s = hero.style;
      if (!d) {
        // 窄屏：整组工位退场（canvas 也不画），hero 回到居中栈
        hero.classList.remove('hero--desk');
        hero.classList.add('hero--stack');
        return;
      }
      hero.classList.add('hero--desk');
      hero.classList.remove('hero--stack');

      // ① 屏：头像嵌进 canvas 的 CRT 屏（DOM 对齐屏矩形，canvas 的 bezel 留在四周）
      const sc = d.crt.screen;
      s.setProperty('--crt-screen-x', `${sc.x}px`);
      s.setProperty('--crt-screen-y', `${sc.y}px`);
      s.setProperty('--crt-screen-w', `${sc.w}px`);
      s.setProperty('--crt-screen-h', `${sc.h}px`);
      // 屏下 bezel（chin）：Press START 一行丝印（左侧起，给右侧电源灯留位）
      const chinY = sc.y + sc.h;
      s.setProperty('--crt-chin-x', `${d.crt.x + 8}px`);
      s.setProperty('--crt-chin-w', `${Math.max(24, d.crt.w - 24)}px`);
      s.setProperty('--crt-chin-y', `${chinY}px`);
      s.setProperty('--crt-chin-h', `${Math.max(8, d.crt.stand.neck.y - chinY)}px`);

      // ② 卡带：立在桌面上（底边 = 桌沿），x = deskSpec.cartXs
      const step = d.cartXs[1] !== undefined ? d.cartXs[1] - d.cartXs[0]! : 30;
      s.setProperty('--cart-bottom', `${h - d.desk.top}px`);
      s.setProperty('--cart-step', `${Math.max(12, step)}px`);
      carts.forEach((c, i) => {
        const x = d.cartXs[i];
        if (x !== undefined) c.style.setProperty('--cart-x', `${x}px`);
      });

      // ③ 铭牌（h1/tagline/intro + 读数）：**左栏文字**（工位住右半屏）——
      // 左缘 = 容器左缘（实测，跟断点/最大宽走），宽度 = 桌面宽（两块等宽、隔空相对）。
      const cont = hero.querySelector<HTMLElement>('.container');
      const left = Math.round((cont ?? hero).getBoundingClientRect().left);
      const right = left + (d.desk.x1 - d.desk.x0);
      const bottomVp = Math.min(d.crt.y, d.lamp.head) - 8;
      const hr = hero.getBoundingClientRect();
      // hero 现在是**第二屏**（ADR-0027）：工位固定在视口坐标，所以铭牌按
      // 「hero 顶对齐视口顶」那一刻对齐桌面（bottomVp 是视口 y，与 hr.top 无关）。
      s.setProperty('--plate-left', `${left}px`);
      s.setProperty('--plate-w', `${Math.max(160, right - left)}px`);
      s.setProperty('--plate-bottom', `${Math.round(hr.height - bottomVp)}px`);

      hero.classList.remove('hero--boot');
      // resize 后 scrollY 未必变但 hero 顶偏移会变：跟章平移量要一并刷新
      syncScene();
    };

    /** 工位淡入淡出 + 跟章平移（alpha 公式与 BgFx.drawWorld 的 deskAlpha 逐字同源） */
    const syncScene = () => {
      const r = hero.getBoundingClientRect();
      // 工位住的是**这一章**（ADR-0027）：两侧对称淡入淡出（顶对齐满亮，进出各淡 0.5 屏）
      const a = Math.max(
        0,
        Math.min(1, 1 - Math.abs(r.top) / Math.max(1, r.height * 0.5))
      );
      hero.style.setProperty('--scene-a', String(a));
      // 工位 DOM 层（fixed 的 .hero-scene / .hero-cta）与 canvas 工位同源跟章：
      // 同一个 hero 顶偏移（取整），CSS 里 translateY(var(--scene-y))。
      // 滚动中途两套坐标一起动，工位与铭牌不再互相漂移（2026-10-01 散架修复）。
      hero.style.setProperty('--scene-y', `${Math.round(r.top)}px`);
      hero.classList.toggle('hero--scene-off', a < 0.05);
    };

    try {
      apply();
      syncScene();
      addEventListener('resize', apply, { passive: true });
      addEventListener('scroll', syncScene, { passive: true });
      addEventListener('load', apply, { once: true });
    } finally {
      // 任何异常都不把内容留在隐藏态（坐标错位也比永久看不见好）
      hero.classList.remove('hero--boot');
    }
  }
</script>

<script>
  import { planSequence, revealPolygon, splitGraphemes } from '../../lib/typewriter';
  import type { GlyphBox, RowBand } from '../../lib/typewriter';

  const root = document.documentElement;
  const host = document.querySelector<HTMLElement>('#hero .hero-text');
  const lines = Array.from(
    document.querySelectorAll<HTMLElement>('#hero [data-tw-line]')
  );
  /**
   * 一行量出的几何。**三套坐标系分开存，绝不能混用**（2026-09-11 两次踩坑）：
   *  ① `clip-path` 的坐标以**元素自身** border box 为参考（`width` / `rows` / `boxes`）；
   *  ② 光标是 host 的绝对定位子元素 → host padding box 相对量（`lefts`/`tops`/`heights`）；
   *  ③ 一次性量的**绝对视口坐标**只能在同一帧内相减。
   *  把 ③ 拿去减「每帧新取的 hostBox」会错位（实测错 68px = 整整一行）：
   *  中间发生了滚动（首页翻页脚本把 hero 顶从 0 推到 60）与入场动画位移
   *  （hero-rise 的 translateY(8px)）。
   */
  interface LineBox {
    el: HTMLElement;
    /** 字素总数（跨文本节点拍平后的计数） */
    count: number;
    /** 裁切参考：元素宽（px） */
    width: number;
    /** 裁切参考：视觉行带（相对元素 border box） */
    rows: RowBand[];
    /** 裁切参考：每个字素在元素内的左/右边界与行号 */
    boxes: GlyphBox[];
    /** 光标参考：每个字素的左边界（相对 host padding box） */
    lefts: number[];
    /** 光标参考：每个字素打印完后的右边界（相对 host padding box） */
    rights: number[];
    /** 光标参考：字格顶 / 高（相对 host padding box） */
    tops: number[];
    heights: number[];
  }

  /** 拍平元素内的**所有**文本节点，逐字素列出（同 pixel-grid.spec.ts 的手法）。
   *  为什么不假设单一文本节点：将来若往 h1/intro 里加 <strong>/<a>，
   *  旧的「childNodes.length === 1」写法会**静默**降级成不打字。 */
  function flatGraphemes(el: HTMLElement): { node: Text; offset: number; text: string }[] {
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    const out: { node: Text; offset: number; text: string }[] = [];
    let n: Node | null;
    while ((n = walker.nextNode())) {
      const t = n as Text;
      for (const g of splitGraphemes(t.data)) {
        out.push({ node: t, offset: g.index, text: g.text });
      }
    }
    return out;
  }

  let caret: HTMLElement | null = null;
  let raf = 0;

  /** 立即揭幕并收尾（幂等；异常路径、resize、打完都走这里） */
  function finish() {
    cancelAnimationFrame(raf);
    for (const el of lines) el.style.removeProperty('clip-path');
    if (caret) caret.hidden = true;
    root.dataset.tw = 'done';
  }

  /** 是否可量：至少有一个非空白文本节点。不满足就整场降级为静态显示。 */
  function measurable(el: HTMLElement): boolean {
    return (el.textContent ?? '').trim().length > 0;
  }

  /**
   * 量一行：逐字素边界 + 视觉行带（与 tests/e2e/pixel-grid.spec.ts 同源手法：Range 取单字几何）。
   * **支持多行**（intro 在桌面就是 2 行）：裁切形状见 `revealPolygon()`。
   */
  function measure(el: HTMLElement): LineBox | null {
    if (!host) return null;
    const glyphs = flatGraphemes(el);
    if (!glyphs.length) return null;
    const hb = host.getBoundingClientRect();
    // host 的 padding box 原点（绝对定位子元素的坐标原点就是这里，不是 border box）
    const ox = hb.left + host.clientLeft;
    const oy = hb.top + host.clientTop;
    const box = el.getBoundingClientRect();
    const range = document.createRange();

    // 视觉行：整段文字的 client rects（每行一个矩形）
    range.selectNodeContents(el);
    const rows: RowBand[] = [...range.getClientRects()]
      .filter((r) => r.width > 1)
      .map((r) => ({ top: r.top - box.top, bottom: r.bottom - box.top }));

    const boxes: GlyphBox[] = [];
    const lefts: number[] = [];
    const rights: number[] = [];
    const tops: number[] = [];
    const heights: number[] = [];
    for (const g of glyphs) {
      range.setStart(g.node, g.offset);
      range.setEnd(g.node, g.offset + g.text.length);
      const r = range.getBoundingClientRect();
      // 归行：取与该字素垂直重叠最多的视觉行
      let row = 0;
      let best = -Infinity;
      rows.forEach((b, i) => {
        const ov = Math.min(b.bottom, r.bottom - box.top) - Math.max(b.top, r.top - box.top);
        if (ov > best) {
          best = ov;
          row = i;
        }
      });
      boxes.push({ left: r.left - box.left, right: r.right - box.left, row });
      lefts.push(r.left - ox);
      rights.push(r.right - ox);
      tops.push(r.top - oy);
      heights.push(r.height);
    }
    return {
      el,
      count: glyphs.length,
      width: box.width,
      rows,
      boxes,
      lefts,
      rights,
      tops,
      heights,
    };
  }

  function ensureCaret(): HTMLElement {
    if (!caret) {
      caret = document.querySelector<HTMLElement>('#hero .tw-caret');
      if (!caret) throw new Error('缺少 #hero .tw-caret');
      caret.hidden = false;
    }
    return caret;
  }

  /** 把光标放到「下一个要打的字」的位置。行内换行与跨行（intro 两行）都自然成立：
   *  x 取下一个字素的左边界，y 取它的字格顶 —— 它落在哪一行就跟到哪一行。 */
  function moveCaret(boxes: LineBox[], lineIdx: number, printed: number) {
    const c = ensureCaret();
    const lb = boxes[lineIdx]!;
    const n = lb.count;
    const i = Math.min(printed, n - 1);
    const x = printed === 0 ? lb.lefts[0]! : lb.rights[printed - 1]!;
    const h = Math.round(lb.heights[i]!);
    c.style.width = `${Math.max(4, Math.round(h * 0.5))}px`;
    c.style.height = `${h}px`;
    c.style.transform = `translate(${Math.round(x)}px, ${Math.round(lb.tops[i]!)}px)`;
  }

  /** 异常一律降级为静态显示：打字机是装饰，绝不能把首屏文字留在裁切态或报错 */
  function safe(fn: () => void): void {
    try {
      fn();
    } catch {
      finish();
    }
  }

  function run() {
    if (!host || !lines.length) return finish();
    // 前置校验：不满足就静态显示（深链 / 滚动恢复 / 结构变了都不打）
    if (!lines.every(measurable)) return finish();
    if (document.querySelector('#hero')!.getBoundingClientRect().top < -8) return finish();

    const boxes = lines.map(measure);
    if (boxes.some((b) => !b)) return finish();
    const geo = boxes as LineBox[];
    const texts = lines.map((el) => el.textContent ?? '');
    const plan = planSequence(texts);
    // 时间线长度必须与实量到的字素数一致，否则宁可不打（不猜、不裁错）
    if (plan.lines.some((l, i) => l.segments.length !== geo[i]!.count)) return finish();
    const t0 = performance.now();

    const frame = (now: number) => {
      try {
        step(now);
      } catch {
        finish();
      }
    };
    const step = (now: number) => {
      const t = now - t0;
      // 逐行推进裁切（时间线已在纯函数里算好，这里只做「到点就推」）
      let active = -1; // 第一个还没打完的行
      let printed = 0;
      for (let li = 0; li < plan.lines.length; li++) {
        const lp = plan.lines[li]!;
        const lb = geo[li]!;
        let n = 0;
        while (n < lp.offsets.length && lp.offsets[n]! <= t) n++;
        if (n >= lb.count) {
          // 本行打完 → 立刻撤掉本行裁切（不是等全部打完）。
          // 除了「已完成的元素不该再挂着裁切」，还有一个实测理由：
          // 带 clip-path 的元素在 Chrome 眼里一直不算「已绘制」，h1 是本站 LCP 元素——
          // 若等到最后一行打完才揭幕，LCP 会被拖到 2.4s；逐行揭幕则回到 ~0.4s。
          lb.el.style.removeProperty('clip-path');
          continue;
        }
        lb.el.style.setProperty('clip-path', revealPolygon(lb.width, lb.rows, lb.boxes, n));
        if (active === -1) {
          active = li;
          printed = n;
        }
      }
      if (active === -1) return finish(); // 全部打完 → 揭幕 + 撤光标
      moveCaret(geo, active, printed);
      raf = requestAnimationFrame(frame);
    };
    raf = requestAnimationFrame(frame);
  }

  if (!host || !lines.length) {
    finish();
  } else {
    // 接管（内联兜底计时器从此失效）
    root.dataset.tw = 'on';
    // 必须显式 load()：document.fonts.ready 在字体尚未被请求时就会 resolve，
    // 用它量边界会拿到**回退字体**的前进量 → 裁在半字形上。
    // 超时（字体没就绪）就**不打字**：宁可静态显示，也不用错的边界硬打
    // （2026-09-11 反例实测：延迟子集 woff2 800ms，旧实现确实按回退字体裁了字）。
    const FONT_WAIT_MS = 400;
    let fontsOk = false;
    const fonts = Promise.all([
      document.fonts.load('32px Zpix'),
      document.fonts.load('14px Zpix'),
    ]).then(
      () => {
        fontsOk = true;
      },
      () => undefined
    );
    const timeout = new Promise((r) => setTimeout(r, FONT_WAIT_MS));
    /** 打字机只在这一章进视口时才打（ADR-0027：hero 是第二屏，加载时它在屏外）。
     *  已经在视口里（深链 / bfcache 回页 / 窄屏一屏放得下）就直接打。 */
    const whenVisible = (fn: () => void) => {
      const el = document.getElementById('hero');
      if (!el || !('IntersectionObserver' in window)) return fn();
      const r = el.getBoundingClientRect();
      if (r.top < window.innerHeight * 0.6 && r.bottom > 0) return fn();
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            io.disconnect();
            fn();
            return;
          }
        },
        { threshold: 0.5 }
      );
      io.observe(el);
    };
    Promise.race([fonts, timeout]).then(
      () => {
        if (!fontsOk) return finish();
        whenVisible(() => safe(run));
      },
      () => finish()
    );
    // resize 会让已量边界失效 → 立刻收尾（宁可静态，也不要裁错位置）
    addEventListener('resize', finish, { passive: true });
  }
</script>

{/* 实况读数更新（ADR-0020）：时刻每 30s 刷（作者城市时区）；天气与 BgFx 共享
    同一次 Open-Meteo 请求（weather.ts 模块级单例去重）。失败静默保持占位词。 */}
<script>
  import { siteWeather } from '../../lib/config';
  import { getLiveWeather, weatherFx, type WeatherKind } from '../../lib/weather';
  import { debugNow, debugWeatherKind } from '../../lib/debug';

  const timeEl = document.querySelector<HTMLElement>('[data-live-time]');
  const wxEl = document.querySelector<HTMLElement>('[data-live-wx]');
  /** 实况天气（未到达 = null）。调试覆写的判定基准：读数与 BgFx 同一函数同一输入 */
  let liveWx: WeatherKind | null = null;
  const tickLive = () => {
    if (!timeEl) return;
    // 走 debugNow：做了时间旅行时读数必须跟着场景走，
    // 否则「LOCAL 14:20 · 星空」这种自相矛盾会当场穿帮。
    timeEl.textContent =
      'LOCAL ' +
      new Intl.DateTimeFormat('en-GB', {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
        timeZone: siteWeather.tz,
      }).format(new Date(debugNow()));
  };
  const tickWx = () => {
    if (wxEl) wxEl.textContent = weatherFx(debugWeatherKind(liveWx)).label;
  };
  tickLive();
  setInterval(tickLive, 30_000);
  getLiveWeather(siteWeather).then((live) => {
    liveWx = live?.kind ?? null;
    tickWx();
  });
  // 调试台（SideDock）改天气 → 立即重刷丝印（否则要等下一次实况到达）
  window.addEventListener('8bit:wx-debug', tickWx);
  // 时间旅行 → 立即重刷时刻（30s tick 太慢，读数行要即时反馈）
  window.addEventListener('8bit:clock-debug', tickLive);
</script>

