---
/**
 * SideDock —— 侧边接插件/排针（ADR-0005 媒介映射）。
 * 5 个原 toggle（CRT / BgFx / Cursor / SFX / Theme）的按钮与脚本迁入这里，
 * DOM/aria/localStorage 语义与原组件完全一致（e2e 契约不破）。
 * 触发按钮固定右侧垂直居中（z=70，在 CRT 扫描线 50 与 cursor canvas 110 之间），
 * 默认收起；点击展开向左侧弹出 5 个 toggle 针脚。状态持久化 8bitme:dock。
 */
import { THEMES } from '../lib/themes';
---

<aside class="side-dock" id="side-dock" data-open="false" aria-label="设置面板">
  <button
    id="side-dock-trigger"
    class="side-dock__trigger pixel-btn"
    type="button"
    aria-expanded="false"
    aria-controls="side-dock-panel"
    aria-label="打开设置面板"
    data-sfx-role="toggle" data-sfx-hover
  >
    <span class="pin" aria-hidden="true"></span>
    <span class="side-dock__trigger-label text-pixel">SET</span>
  </button>

  <div
    id="side-dock-panel"
    class="side-dock__panel"
    role="group"
    aria-label="设置项"
    hidden
  >
    <button id="crt-toggle" class="pixel-btn fx-toggle crt-toggle" type="button" aria-pressed="true" data-sfx-role="toggle" data-sfx-hover>
      <span class="icon">▚</span>
      <span class="label text-pixel">CRT</span>
    </button>
    <button id="bgfx-toggle" class="pixel-btn fx-toggle bgfx-toggle" type="button" aria-pressed="false" aria-label="背景特效：关闭" data-sfx-role="toggle" data-sfx-hover>
      <span class="icon" aria-hidden="true">◆</span>
      <span class="label text-pixel bgfx-label">OFF</span>
    </button>
    <button id="cursor-toggle" class="pixel-btn fx-toggle cursor-toggle" type="button" aria-pressed="true" data-sfx-role="toggle" data-sfx-hover>
      <span class="icon" aria-hidden="true">◎</span>
      <span class="label text-pixel cursor-label">FRAME</span>
    </button>
    <button id="sfx-toggle" class="pixel-btn fx-toggle sfx-toggle" type="button" aria-pressed="true" data-sfx-role="toggle" data-sfx-hover>
      <span class="icon" aria-hidden="true">♪</span>
      <span class="label text-pixel">SFX</span>
    </button>
    <div class="theme-switcher">
      <button id="theme-toggle" class="pixel-btn fx-toggle theme-toggle" type="button" aria-expanded="false" aria-haspopup="true" aria-controls="theme-panel" data-sfx-role="toggle" data-sfx-hover>
        <span class="icon" aria-hidden="true">◨</span>
        <span class="label text-pixel">THEME</span>
      </button>
      <div id="theme-panel" class="theme-panel" hidden>
        <ul>
          {THEMES.map((t) => (
            <li>
              <button type="button" class="theme-item" data-theme-key={t.key} title={`${t.label} · ${t.desc}`} data-sfx-role="select" data-sfx-hover>
                <span class="sw" aria-hidden="true">{t.colors.map((c) => (<i style={`background-color:${c}`}></i>))}</span>
                <span class="txt"><span class="name">{t.label}</span><span class="desc">{t.desc}</span></span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</aside>

<script>
  import { crtPref, bgfxPref, cursorPref, sfxPref, themePref } from '../lib/prefs';
  import { isValidTheme, DEFAULT_THEME, meetsContrast, THEMES } from '../lib/themes';

  // ── CRT（与原 CrtOverlay 等价） ──
  const overlay = document.getElementById('crt-overlay') as HTMLElement;
  const crtBtn = document.getElementById('crt-toggle') as HTMLButtonElement;
  let crtOn = crtPref.get();
  const applyCrt = () => {
    overlay.hidden = !crtOn;
    crtBtn.setAttribute('aria-pressed', String(crtOn));
    crtBtn.classList.toggle('off', !crtOn);
  };
  crtBtn.addEventListener('click', () => {
    crtOn = !crtOn; crtPref.set(crtOn); applyCrt();
    crtBtn.blur();
  });
  applyCrt();

  // ── BgFx（与原 BgFx 等价） ──
  const MODES = ['off', 'core', 'stars', 'scan', 'rain', 'wave', 'grid'] as const;
  const LABELS: Record<typeof MODES[number], string> = { off:'OFF', core:'CORE', stars:'STAR', scan:'SCAN', rain:'RAIN', wave:'WAVE', grid:'GRID' };
  const bgfxBtn = document.getElementById('bgfx-toggle') as HTMLButtonElement;
  const bgfxLabel = bgfxBtn.querySelector('.bgfx-label') as HTMLElement;
  // localStorage 首次访问返回 null；需要回退到默认 mode（原 BgFx.astro 的 normalize）
  const normBgfx = (v: string | null): typeof MODES[number] =>
    v && (MODES as readonly string[]).includes(v) ? (v as typeof MODES[number]) : 'off';
  let bgfxMode: typeof MODES[number] = normBgfx(bgfxPref.get());
  const applyBgfx = () => {
    bgfxLabel.textContent = LABELS[bgfxMode];
    bgfxBtn.setAttribute('aria-pressed', bgfxMode === 'off' ? 'false' : 'true');
    bgfxBtn.setAttribute('aria-label', `背景特效：${LABELS[bgfxMode]}`);
    bgfxBtn.classList.toggle('off', bgfxMode === 'off');
    document.documentElement.dataset.bgfx = bgfxMode;
  };
  bgfxBtn.addEventListener('click', () => {
    const i = (MODES as readonly string[]).indexOf(bgfxMode);
    bgfxMode = MODES[(i + 1) % MODES.length]!;
    bgfxPref.set(bgfxMode); applyBgfx();
    bgfxBtn.blur();
  });
  applyBgfx();

  // ── CursorFx（非精细指针自删按钮，与原 CursorFx 等价） ──
  const C_MODES = ['off','frame','dot','block','cross','reticle'] as const;
  const C_LABELS: Record<typeof C_MODES[number], string> = { off:'OFF', frame:'FRAME', dot:'DOT', block:'BLK', cross:'CROSS', reticle:'RET' };
  const cursorBtn = document.getElementById('cursor-toggle') as HTMLButtonElement;
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (!finePointer) {
    cursorBtn.remove();
  } else {
    const cursorLabel = cursorBtn.querySelector('.cursor-label') as HTMLElement;
    // localStorage 首次访问返回 null；回退默认 'frame'（原 CursorFx 的 normalize）
    const normCursor = (v: string | null): typeof C_MODES[number] =>
      v && (C_MODES as readonly string[]).includes(v) ? (v as typeof C_MODES[number]) : 'frame';
    let cursorMode: typeof C_MODES[number] = normCursor(cursorPref.get());
    const applyCursor = () => {
      cursorLabel.textContent = C_LABELS[cursorMode];
      cursorBtn.setAttribute('aria-pressed', cursorMode === 'off' ? 'false' : 'true');
      cursorBtn.classList.toggle('off', cursorMode === 'off');
      document.documentElement.classList.toggle('cursor-fx-on', cursorMode !== 'off');
    };
    cursorBtn.addEventListener('click', () => {
      const i = (C_MODES as readonly string[]).indexOf(cursorMode);
      cursorMode = C_MODES[(i + 1) % C_MODES.length]!;
      cursorPref.set(cursorMode); applyCursor();
      cursorBtn.blur();
    });
    applyCursor();
  }

  // ── SFX（与原 SfxToggle 等价） ──
  const sfxBtn = document.getElementById('sfx-toggle') as HTMLButtonElement;
  let sfxOn = sfxPref.get();
  const applySfx = () => {
    sfxBtn.setAttribute('aria-pressed', String(sfxOn));
    sfxBtn.classList.toggle('off', !sfxOn);
  };
  sfxBtn.addEventListener('click', () => {
    sfxOn = !sfxOn; sfxPref.set(sfxOn); applySfx();
    sfxBtn.blur();
  });
  applySfx();

  // ── Theme（与原 ThemeToggle 等价；面板向左弹出见 CSS） ──
  const themeBtn = document.getElementById('theme-toggle') as HTMLButtonElement;
  const themePanel = document.getElementById('theme-panel') as HTMLElement;
  const themeItems = Array.from(themePanel.querySelectorAll<HTMLButtonElement>('.theme-item'));
  const currentKey = (): string => {
    const v = document.documentElement.dataset.theme;
    return v && isValidTheme(v) ? v : DEFAULT_THEME;
  };
  const markCurrent = () => {
    const cur = currentKey();
    themeItems.forEach((it) => {
      const on = it.dataset.themeKey === cur;
      it.classList.toggle('is-current', on);
      it.setAttribute('aria-pressed', String(on));
    });
  };
  const openTheme = () => { markCurrent(); themePanel.hidden = false; themeBtn.setAttribute('aria-expanded', 'true'); };
  const closeTheme = () => { themePanel.hidden = true; themeBtn.setAttribute('aria-expanded', 'false'); };
  themeBtn.addEventListener('click', () => { themePanel.hidden ? openTheme() : closeTheme(); });
  document.addEventListener('click', (e) => {
    if (themePanel.hidden) return;
    const t = e.target instanceof Node ? e.target : null;
    if (t && !themeBtn.contains(t) && !themePanel.contains(t)) closeTheme();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !themePanel.hidden) { closeTheme(); themeBtn.focus(); }
  });
  themeItems.forEach((it) => {
    it.addEventListener('click', () => {
      const k = it.dataset.themeKey;
      if (!k || !isValidTheme(k)) return;
      // 对比度守门：正文(--gb-3) vs 底(--gb-0) 低于 WCAG AA 的主题不应用（仍可被篡改，但 UI 不主动选）
      const theme = THEMES.find((t) => t.key === k);
      if (theme && !meetsContrast(theme.colors[3], theme.colors[0], 4.5)) return;
      document.documentElement.dataset.theme = k;
      themePref.set(k);
      markCurrent(); closeTheme(); themeBtn.focus();
      const root = document.documentElement;
      root.classList.remove('theme-flash');
      void root.offsetWidth;
      root.classList.add('theme-flash');
    });
  });

  // ── Dock 自身开/关（独立持久化） ──
  const dock = document.getElementById('side-dock') as HTMLElement;
  const trigger = document.getElementById('side-dock-trigger') as HTMLButtonElement;
  const panel = document.getElementById('side-dock-panel') as HTMLElement;
  const DOCK_KEY = '8bitme:dock';
  const dockOpen = (): boolean => dock.dataset.open === 'true';
  const setDock = (open: boolean) => {
    dock.dataset.open = String(open);
    trigger.setAttribute('aria-expanded', String(open));
    trigger.setAttribute('aria-label', open ? '关闭设置面板' : '打开设置面板');
    panel.hidden = !open;
    try { localStorage.setItem(DOCK_KEY, open ? 'on' : 'off'); } catch {}
    if (open) {
      const first = panel.querySelector<HTMLButtonElement>('button.pixel-btn');
      first?.focus();
    }
  };
  trigger.addEventListener('click', () => {
    setDock(!dockOpen());
  });
  // dock 外部点击关闭
  document.addEventListener('click', (e) => {
    if (!dockOpen()) return;
    const t = e.target instanceof Node ? e.target : null;
    if (t && dock.contains(t)) return;
    setDock(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && dockOpen()) { setDock(false); trigger.focus(); }
  });
  // SSR 首帧：尊重 localStorage
  try {
    const saved = localStorage.getItem(DOCK_KEY);
    if (saved === 'on') setDock(true);
  } catch {}
</script>

<style>
  /* ─── 侧边接插件 / 排针（PCB 媒介） ─── */
  .side-dock {
    position: fixed;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    z-index: 70;
    display: flex;
    align-items: stretch;
    gap: 0.4rem;
  }
  .side-dock__trigger {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.55rem 0.4rem;
    font-size: 0.5rem;
    background-color: var(--gb-0);
  }
  .side-dock__trigger-label {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    letter-spacing: 0.1em;
  }
  /* 8 个 4×4 焊盘（两列）模拟排针 */
  .side-dock__trigger .pin {
    width: 8px;
    height: 8px;
    background-color: var(--gb-2);
    box-shadow:
      12px 0 0 var(--gb-2),
      0 12px 0 var(--gb-2),
      12px 12px 0 var(--gb-2),
      0 24px 0 var(--gb-2),
      12px 24px 0 var(--gb-2);
  }
  /* 展开：触发按钮"通电" */
  .side-dock[data-open='true'] .side-dock__trigger {
    background-color: color-mix(in srgb, var(--gb-2) 30%, var(--gb-0));
    box-shadow: inset 3px 0 0 var(--gb-2);
  }
  /* 面板 */
  .side-dock__panel {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.5rem;
    background-color: color-mix(in srgb, var(--gb-1) 35%, var(--gb-0));
    border: 4px solid var(--color-border);
    box-shadow:
      inset 4px 4px 0 color-mix(in srgb, var(--gb-3) 10%, transparent),
      -4px 4px 0 color-mix(in srgb, var(--gb-1) 70%, transparent);
  }
  /* fx-toggle 在仓内由 flex 接管 */
  .side-dock__panel[hidden] { display: none; }
  .side-dock__panel .fx-toggle {
    position: static !important;
    bottom: auto; left: auto; right: auto;
  }
  /* Theme 容器在仓内 */
  .side-dock__panel .theme-switcher { position: relative; }
  /* Theme 面板：向左弹出 */
  .theme-panel {
    position: absolute;
    right: calc(100% + 0.6rem);
    top: 0;
    width: 17rem;
    max-height: min(60vh, 22rem);
    overflow-y: auto;
    border: 4px solid var(--color-border);
    background-color: color-mix(in srgb, var(--gb-1) 55%, var(--gb-0));
    box-shadow:
      inset 4px 4px 0 color-mix(in srgb, var(--gb-3) 10%, transparent),
      -4px 4px 0 color-mix(in srgb, var(--gb-1) 70%, transparent);
    scrollbar-width: none;
  }
  .theme-panel::-webkit-scrollbar { display: none; }
  .theme-panel[hidden] { display: block; opacity: 0; visibility: hidden; pointer-events: none; }
  .theme-panel:not([hidden]) { opacity: 1; visibility: visible; }
  .theme-panel ul { margin: 0; padding: 0.4rem; list-style: none; }
  .theme-item {
    display: flex; align-items: center; gap: 0.6rem;
    width: 100%;
    padding: 0.45rem 0.55rem;
    border: 0; background-color: transparent;
    color: var(--color-text);
    font-family: var(--font-pixel); font-size: 0.6rem;
    text-align: left; cursor: pointer;
  }
  .theme-item:hover { background-color: color-mix(in srgb, var(--gb-3) 12%, transparent); }
  .theme-item:active { transform: translate(2px, 2px); }
  .theme-item.is-current {
    background-color: color-mix(in srgb, var(--gb-2) 25%, transparent);
    box-shadow: inset 3px 0 0 var(--gb-2);
  }
  .theme-item .sw { display: inline-flex; gap: 2px; flex-shrink: 0; }
  .theme-item .sw i { width: 0.6rem; height: 0.6rem; }
  .theme-item .txt { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .theme-item .name { line-height: 1.3; white-space: nowrap; text-transform: none; }
  .theme-item .desc {
    font-family: var(--font-body); font-size: 0.6rem;
    color: var(--color-text-dim); line-height: 1.2;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    text-transform: none;
  }
  @media (max-width: 560px) {
    .side-dock__trigger-label { font-size: 0.45rem; }
    .theme-panel { right: auto; left: calc(100% + 0.6rem); width: 15rem; }
  }
</style>
