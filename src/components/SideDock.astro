---
/**
 * SideDock —— 右侧设置仓（原「侧边接插件」，2026-09 随 ADR-0021 去机器化改名）。
 * 5 个 toggle：BgFx / Cursor / SFX / Mode / DEV（天空调试台总开关，默认关）。
 * 触发按钮固定右侧垂直居中（z=70），默认收起；点击展开向左侧弹出。
 * 状态持久化 8bitme:dock；
 * 天空调试持久化 8bitme:wxdebug / wx-kind / clock-offset（见 src/lib/debug.ts）。
 */
---

{
  /* 右侧 SET 仓整体**只在 DEV 构建存在**（2026-09-25 作者：「右侧那个按钮是留给自己开发调试的，
     整个都不要上线」）——生产 dist 里 trigger / 面板 / 全部开关连节点都不渲染。
     做法与 DEV 调试台同门：import.meta.env.DEV（模板不渲染 + 脚本不接线）。 */
  import.meta.env.DEV && (
  <aside class="side-dock" id="side-dock" data-open="false" aria-label="设置面板">
  <button
    id="side-dock-trigger"
    class="side-dock__trigger pixel-btn"
    type="button"
    aria-expanded="false"
    aria-controls="side-dock-panel"
    aria-label="打开设置面板"
    data-sfx-role="toggle" data-sfx-hover
  >
    <span class="side-dock__trigger-label text-pixel">SET</span>
  </button>

  <div
    id="side-dock-panel"
    class="side-dock__panel"
    role="group"
    aria-label="设置项"
    hidden
  >
    <button id="bgfx-toggle" class="pixel-btn fx-toggle bgfx-toggle" type="button" aria-pressed="true" aria-label="背景特效：WORLD" data-sfx-role="toggle" data-sfx-hover>
      <span class="icon" aria-hidden="true">◆</span>
      <span class="label text-pixel bgfx-label">WORLD</span>
    </button>
    <button id="cursor-toggle" class="pixel-btn fx-toggle cursor-toggle" type="button" aria-pressed="true" data-sfx-role="toggle" data-sfx-hover>
      <span class="icon" aria-hidden="true">◎</span>
      <span class="label text-pixel cursor-label">FRAME</span>
    </button>
    <button id="sfx-toggle" class="pixel-btn fx-toggle sfx-toggle" type="button" aria-pressed="true" data-sfx-role="toggle" data-sfx-hover>
      <span class="icon" aria-hidden="true">♪</span>
      <span class="label text-pixel">SFX</span>
    </button>
    <!-- DEV = 天空调试台总开关（作者玩具）：**只在 DEV 构建存在**（2026-09-25 作者
         「不要把 dev 功能上线」）——生产构建里这一段整体不渲染，入口与子面板都不进 HTML。
         文案恒为 DEV（不改字），状态靠 .off 反转态 + aria-pressed 表意。 -->
    {import.meta.env.DEV && (<>
    <button id="wx-debug-toggle" class="pixel-btn fx-toggle" type="button" aria-pressed="false" aria-label="天空调试：天气与时间" data-sfx-role="toggle" data-sfx-hover>
      <span class="icon" aria-hidden="true">※</span>
      <span class="label text-pixel">DEV</span>
    </button>
    <div id="wx-debug-panel" class="wx-debug" role="group" aria-label="天空调试" hidden>
      <div class="wx-debug__row">
        <button id="wx-debug-cycle" class="pixel-btn wx-debug__btn text-pixel" type="button" aria-label="调试天气：实况">实况</button>
      </div>
      <div class="wx-debug__row">
        <button id="wx-time-minus" class="pixel-btn wx-debug__btn text-pixel" type="button" aria-label="时间旅行：倒退一小时">-1H</button>
        <span id="wx-clock-label" class="text-pixel wx-debug__clock">实况</span>
        <button id="wx-time-plus" class="pixel-btn wx-debug__btn text-pixel" type="button" aria-label="时间旅行：前进一小时">+1H</button>
        <button id="wx-time-reset" class="pixel-btn wx-debug__btn text-pixel" type="button" aria-label="时间旅行：归零">归零</button>
      </div>
    </div>
    </>)}
  </div>
  </aside>
  )
}

<script>
  import { bgfxPref, cursorPref, sfxPref } from '../lib/prefs';
  import { weatherFx, type WeatherKind } from '../lib/weather';
  import {
    clockOffsetMs,
    setClockOffsetMs,
    setWxDebugKind,
    wxDebugCycleNext,
    wxDebugKind,
    wxDebugOn,
  } from '../lib/debug';

  // 整个右侧 SET 仓（trigger + 面板 + 全部开关）**只在 DEV 构建接线**：
  // 生产构建模板不渲染这些元素，不加门会 getElementById 拿到 null 后崩。
  if (import.meta.env.DEV) {
  // ── BgFx（双档：world「窗外」默认 / off；core 机箱已退役——2026-09-25 作者裁决） ──
  const MODE_LIST = ['off', 'world'] as const;
  const LABELS: Record<typeof MODE_LIST[number], string> = { off:'OFF', world:'WORLD' };
  const bgfxBtn = document.getElementById('bgfx-toggle') as HTMLButtonElement;
  const bgfxLabel = bgfxBtn.querySelector('.bgfx-label') as HTMLElement;
  // 归一：无存档 → world；'core'（已退役）/ v4 五滤镜 / 其他脏值 → world（不让老访客停在老模式上）
  const normBgfx = (v: string | null): typeof MODE_LIST[number] =>
    v === 'world' || v === 'off' ? v : 'world';
  let bgfxMode: typeof MODE_LIST[number] = normBgfx(bgfxPref.get());
  const applyBgfx = () => {
    bgfxLabel.textContent = LABELS[bgfxMode];
    bgfxBtn.setAttribute('aria-pressed', bgfxMode === 'off' ? 'false' : 'true');
    bgfxBtn.setAttribute('aria-label', `背景特效：${LABELS[bgfxMode]}`);
    bgfxBtn.classList.toggle('off', bgfxMode === 'off');
    document.documentElement.dataset.bgfx = bgfxMode;
  };
  bgfxBtn.addEventListener('click', () => {
    const i = (MODE_LIST as readonly string[]).indexOf(bgfxMode);
    bgfxMode = MODE_LIST[(i + 1) % MODE_LIST.length]!;
    bgfxPref.set(bgfxMode); applyBgfx();
    bgfxBtn.blur();
  });
  applyBgfx();

  // ── CursorFx（非精细指针自删按钮） ──
  const C_MODES = ['off','frame','dot','block','cross','reticle'] as const;
  const C_LABELS: Record<typeof C_MODES[number], string> = { off:'OFF', frame:'FRAME', dot:'DOT', block:'BLK', cross:'CROSS', reticle:'RET' };
  const cursorBtn = document.getElementById('cursor-toggle') as HTMLButtonElement;
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (!finePointer) {
    cursorBtn.remove();
  } else {
    const cursorLabel = cursorBtn.querySelector('.cursor-label') as HTMLElement;
    const normCursor = (v: string | null): typeof C_MODES[number] =>
      v && (C_MODES as readonly string[]).includes(v) ? (v as typeof C_MODES[number]) : 'frame';
    let cursorMode: typeof C_MODES[number] = normCursor(cursorPref.get());
    const applyCursor = () => {
      cursorLabel.textContent = C_LABELS[cursorMode];
      cursorBtn.setAttribute('aria-pressed', cursorMode === 'off' ? 'false' : 'true');
      cursorBtn.classList.toggle('off', cursorMode === 'off');
      document.documentElement.classList.toggle('cursor-fx-on', cursorMode !== 'off');
    };
    cursorBtn.addEventListener('click', () => {
      const i = (C_MODES as readonly string[]).indexOf(cursorMode);
      cursorMode = C_MODES[(i + 1) % C_MODES.length]!;
      cursorPref.set(cursorMode); applyCursor();
      cursorBtn.blur();
    });
    applyCursor();
  }

  // ── SFX ──
  const sfxBtn = document.getElementById('sfx-toggle') as HTMLButtonElement;
  let sfxOn = sfxPref.get();
  const applySfx = () => {
    sfxBtn.setAttribute('aria-pressed', String(sfxOn));
    sfxBtn.classList.toggle('off', !sfxOn);
  };
  sfxBtn.addEventListener('click', () => {
    sfxOn = !sfxOn; sfxPref.set(sfxOn); applySfx();
    sfxBtn.blur();
  });
  applySfx();

  // ── DEV：天空调试台（天气覆写 + 时间旅行；作者玩具）——**只在 DEV 构建接线**：
  // 生产构建模板不渲染这些元素，故整段挂 DEV 门下（否则 getElementById 拿到 null 崩）。
  if (import.meta.env.DEV) {
    // ── DEV：天空调试台（天气覆写 + 时间旅行；作者玩具，默认关） ──
    // 纯值逻辑住 src/lib/debug.ts（可单测）；这里只做「改值 + 重绘 + 派发事件」。
    // 两个事件：8bit:wx-debug → BgFx 重算天气 + Hero 重刷丝印；
    //          8bit:clock-debug → Hero 立即重刷时刻（BgFx 下一帧自己读 debugNow）。
    const WX_HOUR_MS = 3_600_000;
    const wxBtn = document.getElementById('wx-debug-toggle') as HTMLButtonElement;
    const wxPanel = document.getElementById('wx-debug-panel') as HTMLElement;
    const wxCycleBtn = document.getElementById('wx-debug-cycle') as HTMLButtonElement;
    const wxClockLabel = document.getElementById('wx-clock-label') as HTMLElement;
    const wxTimeMinus = document.getElementById('wx-time-minus') as HTMLButtonElement;
    const wxTimePlus = document.getElementById('wx-time-plus') as HTMLButtonElement;
    const wxTimeReset = document.getElementById('wx-time-reset') as HTMLButtonElement;
    /** 天气档位显示词：null（实况）用中文，其余用与丝印同源的 weatherFx().label */
    const wxKindLabel = (kind: WeatherKind | null): string =>
      kind === null ? '实况' : weatherFx(kind).label;
    /** 偏移读数（整小时；非整小时四舍五入，±0 一律显示「实况」） */
    const clockLabel = (ms: number): string => {
      const hours = Math.round(ms / WX_HOUR_MS);
      if (hours === 0) return '实况';
      return `${hours > 0 ? '+' : '-'}${Math.abs(hours)}H`;
    };
    const applyWxDebug = () => {
      const on = wxDebugOn.get();
      wxBtn.setAttribute('aria-pressed', String(on));
      // 复用既有 off 态语言（变暗 + 删除线）：「DEV 生效了吗」靠这一眼
      wxBtn.classList.toggle('off', !on);
      wxPanel.hidden = !on;
      const kind = wxDebugKind();
      wxCycleBtn.textContent = wxKindLabel(kind);
      wxCycleBtn.setAttribute('aria-label', `调试天气：${wxKindLabel(kind)}`);
      wxClockLabel.textContent = clockLabel(clockOffsetMs());
    };
    const dispatchWxDebug = () =>
      window.dispatchEvent(new CustomEvent('8bit:wx-debug'));
    const dispatchClockDebug = () =>
      window.dispatchEvent(new CustomEvent('8bit:clock-debug'));
    wxBtn.addEventListener('click', () => {
      wxDebugOn.set(!wxDebugOn.get());
      applyWxDebug();
      // 关掉时 BgFx 会自动回落实况（debugWeatherKind 自己判开关）
      dispatchWxDebug();
      wxBtn.blur();
    });
    wxCycleBtn.addEventListener('click', () => {
      // 环 = [实况, ...WX_DEBUG_KINDS]，末尾再点回实况；当前值不在环里时从实况起步
      setWxDebugKind(wxDebugCycleNext(wxDebugKind()));
      applyWxDebug();
      dispatchWxDebug();
      wxCycleBtn.blur();
    });
    const nudgeClock = (deltaMs: number) => {
      setClockOffsetMs(clockOffsetMs() + deltaMs);
      applyWxDebug();
      dispatchClockDebug();
    };
    wxTimeMinus.addEventListener('click', () => { nudgeClock(-WX_HOUR_MS); wxTimeMinus.blur(); });
    wxTimePlus.addEventListener('click', () => { nudgeClock(WX_HOUR_MS); wxTimePlus.blur(); });
    wxTimeReset.addEventListener('click', () => { setClockOffsetMs(0); applyWxDebug(); dispatchClockDebug(); wxTimeReset.blur(); });
    applyWxDebug();

  }

  // ── Dock 自身开/关（独立持久化） ──
  const dock = document.getElementById('side-dock') as HTMLElement;
  const trigger = document.getElementById('side-dock-trigger') as HTMLButtonElement;
  const panel = document.getElementById('side-dock-panel') as HTMLElement;
  const DOCK_KEY = '8bitme:dock';
  const dockOpen = (): boolean => dock.dataset.open === 'true';
  const setDock = (open: boolean) => {
    dock.dataset.open = String(open);
    trigger.setAttribute('aria-expanded', String(open));
    trigger.setAttribute('aria-label', open ? '关闭设置面板' : '打开设置面板');
    panel.hidden = !open;
    try { localStorage.setItem(DOCK_KEY, open ? 'on' : 'off'); } catch {}
    if (open) {
      const first = panel.querySelector<HTMLButtonElement>('button.pixel-btn');
      first?.focus();
    }
  };
  trigger.addEventListener('click', () => {
    setDock(!dockOpen());
  });
  // dock 外部点击关闭
  document.addEventListener('click', (e) => {
    if (!dockOpen()) return;
    const t = e.target instanceof Node ? e.target : null;
    if (t && dock.contains(t)) return;
    setDock(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && dockOpen()) { setDock(false); trigger.focus(); }
  });
  // SSR 首帧：尊重 localStorage
  try {
    const saved = localStorage.getItem(DOCK_KEY);
    if (saved === 'on') setDock(true);
  } catch {}
  }
</script>

<style>
  /* ─── 右侧设置仓 ─── */
  .side-dock {
    position: fixed;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    z-index: 70;
    display: flex;
    align-items: stretch;
    gap: 0.4rem;
  }
  .side-dock__trigger {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.55rem 0.4rem;
    font-size: 0.75rem;
    line-height: 16px;
  }
  .side-dock__trigger-label {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    letter-spacing: 0.1em;
  }
  /* 窄屏（≤960px）：停靠右下角，避开内容列 */
  @media (max-width: 960px) {
    .side-dock {
      top: auto;
      bottom: 0.75rem;
      right: 0.75rem;
      transform: none;
    }
  }

  /* 展开：触发按钮通电 */
  .side-dock[data-open='true'] .side-dock__trigger {
    background-color: color-mix(in srgb, var(--c-accent) 18%, var(--c-panel));
    border-color: var(--c-accent);
    box-shadow: inset 3px 0 0 var(--c-accent);
  }
  /* 面板 */
  .side-dock__panel {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.5rem;
    background-color: var(--c-panel);
    border: 1px solid var(--c-line);
    border-right: none;
    box-shadow: -3px 3px 0 color-mix(in srgb, var(--c-line) 45%, transparent);
  }
  .side-dock__panel[hidden] { display: none; }
  .side-dock__panel .fx-toggle {
    position: static !important;
    bottom: auto; left: auto; right: auto;
    box-shadow: none;
  }
  /* 调试子面板（DEV 总开关控制显隐）：小一号的按钮，与上面四个开关形成「主控件 / 工具」层级 */
  .wx-debug {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.4rem;
    border-top: 1px solid color-mix(in srgb, var(--c-line) 60%, transparent);
  }
  /* 必须显式覆盖：上面的 display:flex 会盖掉 UA 的 [hidden] */
  .wx-debug[hidden] {
    display: none;
  }
  .wx-debug__row {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .wx-debug__btn {
    padding: 0.3rem 0.45rem;
    font-size: 0.75rem;
    line-height: 1.4;
    box-shadow: none;
  }
  .wx-debug__clock {
    min-width: 2.6rem;
    text-align: center;
    font-size: 0.75rem;
    line-height: 16px;
    color: var(--color-text-dim);
  }

  @media (max-width: 560px) {
    .side-dock__trigger-label { font-size: 0.75rem; line-height: 16px; }
  }
</style>
