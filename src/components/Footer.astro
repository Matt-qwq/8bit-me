---
import { siteConfig } from '../lib/config';
import { iconSvgInner } from '../lib/pixel-icons';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p class="foot-mark text-pixel" aria-hidden="true">8BIT-ME</p>
    <p class="text-pixel foot-line">
      <svg
        width="15"
        height="15"
        viewBox="0 0 15 15"
        shape-rendering="crispEdges"
        aria-hidden="true"
        class="foot-icon"
        set:html={iconSvgInner('rocket', 'var(--c-accent)')}
      />© {year} {siteConfig.author} · built with Astro
    </p>
    <p class="foot-credit">
      <svg
        width="15"
        height="15"
        viewBox="0 0 15 15"
        shape-rendering="crispEdges"
        aria-hidden="true"
        class="foot-icon"
        set:html={iconSvgInner('font', 'var(--c-accent)')}
      />中文像素字体 <a href="https://github.com/SolidZORO/zpix-pixel-font" target="_blank" rel="noopener" data-sfx-role="click">Zpix</a> by SolidZORO
    </p>
  </div>

  <!-- 猫（截图脚本/过往草稿）已从 footer 移除：2026-08-31 决定只在 Nav 放一只睡猫，底部不再放猫。 -->
</footer>

<style>
  /* 普通页脚：贴在内容底部一行，不再独占一屏（2026-08-31 作者要求）。 */
  .footer {
    position: relative;
    margin-top: 0;
    padding: 1rem 0;
    border-top: 1px solid color-mix(in srgb, var(--c-line) 40%, transparent);
  }

  /* 像素签名（homepage-optimization-v1 · B2，2026-10-01 作者批准）：
     Zpix 48px + 1px 描边、填充透明 = 空心阶梯字标（eboy 的空心 logo 语言，
     比 1px 结构线重、比实心像素块轻）。描边走 --c-line token 随主题；
     是文本层不是装饰层（texture-budget 不计），aria-hidden（与 Nav 站名重复）。 */
  .foot-mark {
    /* 整数 px，不用 rem 小数：0.6rem=9.6px 会把整块页脚的行盒顶推到
       x.594 这种半像素上——Zpix 的 1px 笔画落在半像素就整段发灰（2026-11-13
       放大 3 倍实拍：© 行与 8BIT-ME 的描边都带灰边）。页脚三行必须各自
       落整数 y：10 / 56 / 17 / 6 全整数。 */
    margin: 10px 0 8px;
    height: 56px; /* 显式整数高：Zpix 48px 的字体盒是 56.064px，不钉死就会把下一行顶到 .064 */
    font-size: 3rem; /* 48px 档 */
    line-height: 56px;
    letter-spacing: var(--ls-48);
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1px var(--c-line);
  }

  .foot-line {
    /* margin 归零 + 行高 17px：15px 图标按 vertical-align:-2px 会把行盒撑到 17px，
       16px 的行高就永远对不上整数，页脚最后一行也跟着漂 */
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: var(--ls-12);
    line-height: 17px;
    color: var(--color-text-dim);
    text-align: center;
  }

  /* 行内点阵图标（B3 复用）：火箭 = built with Astro、字模 A = 像素字体署名。
     标识语言非装饰层；基线对齐压 2px 坐 12px 丝印行。 */
  .foot-icon {
    vertical-align: -2px;
    margin-right: 5px;
  }

  .foot-credit {
    /* 8px：48px 字标 → 12px 说明行 → 12px 署名行，三块之间各留 8px。
       2026-11-13 上一版把 © 行的 UA margin 清零后又只给 6px，两行小字挤成一块
       （作者：「重叠在一起了」）——间距必须是显式整数，不能靠 UA 默认值。 */
    margin: 8px 0 0;
    /* 署名行是**丝印标签**不是正文：跟上面一行同用 Zpix + --ls-12。
       旧版这里走 --font-body（系统黑体），390px 下一行像素字一行黑体，
       肉眼一眼看出「这行不属于这个站」（2026-11-13 作者指出）。 */
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    letter-spacing: var(--ls-12);
    line-height: 16px;
    height: 16px;
    color: var(--color-text-dim);
    text-align: center;
  }
  .foot-credit a {
    /* 文字结构色 + 强调色下划线（accent 作文字在 dawnbringer-ember 4.02 破 AA） */
    color: var(--color-text-dim);
    text-decoration: underline;
    text-decoration-color: var(--c-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .foot-credit a:hover {
    text-decoration: underline;
  }
</style>
