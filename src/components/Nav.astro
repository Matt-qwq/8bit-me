---
import { siteConfig, url } from '../lib/config';

/**
 * Nav 由 BaseLayout 全站挂载，而 siteConfig.nav 是首页 section 的纯锚点
 * （#hero / #about / …）。博客页与 404 页的 DOM 里没有这些 id，
 * 直接渲染纯锚点会让点击静默失效（2026-08-29 作者发现的 bug）。
 * 因此：首页保留纯锚点（平滑滚动 + scrollspy 生效），
 * 非首页一律降级为「首页 + 锚点」的绝对路径。
 */
const home = url('/');
const isHome = Astro.url.pathname === home;
const sectionHref = (hash: string) => (isHome ? hash : `${home}${hash}`);

/**
 * 路由级激活态：博客列表页与文章页没有首页那些 section，scrollspy 整段跳过，
 * 若只靠它，这两类页面上一个高亮都没有，访客看不出自己在哪。
 * 因此「博客」项由 pathname 在服务端定，与 scrollspy 的 section 级激活互补。
 */
const blog = url('blog');
const isBlog =
  Astro.url.pathname === blog || Astro.url.pathname.startsWith(`${blog}/`);
/** 实验场（/lab）：交互式图册。与博客同理——非首页路由，scrollspy 管不到 */
const lab = url('lab');
const isLab =
  Astro.url.pathname === lab || Astro.url.pathname.startsWith(`${lab}/`);
---

<header class="nav">
  <div class="nav-inner container">
    <a class="logo text-pixel" href="#main" data-sfx-role="nav" data-sfx-hover>8bit<span class="dot">.</span>me</a>
    <nav aria-label="主导航">
      <ul>
        {siteConfig.nav.map((item) => (
          <li>
            <a href={sectionHref(item.href)} data-sfx-role="nav" data-sfx-hover>{item.label}</a>
          </li>
        ))}
        <li>
          <a
            href={blog}
            class:list={[{ 'is-active': isBlog }]}
            aria-current={isBlog ? 'page' : undefined}
            data-sfx-role="nav" data-sfx-hover>博客</a
          >
        </li>
        <li>
          <a
            href={lab}
            class:list={[{ 'is-active': isLab }]}
            aria-current={isLab ? 'page' : undefined}
            data-sfx-role="nav" data-sfx-hover>实验场</a
          >
        </li>
      </ul>
    </nav>
    <!-- 丝印层吉祥物：坐在板边打瞌睡的睡猫（GIF 呼吸动画，2026-08-31 由 pose1 睡姿素材抠透明）。
         刻意不用 <a> 包裹：nav-links.spec.ts 有「全站 a[href^="#"] 目标必须存在」的硬契约，
         装饰元素包成锚点会在 /blog、/404 上炸掉。纯装饰 → alt='' 且不进 tab 序。 -->
    <span class="nav-cat" aria-hidden="true">
      <img class="nav-cat__img" src={url('/cats/nav_sleep.gif')} alt="" />
    </span>
  </div>
</header>

<script>
  // scrollspy：当前 section 高亮对应导航项（非首页无这些 section，直接跳过）
  // 选择器用 [href*="#"] 而非 [href^="#"]：非首页的导航项 href 是 "/#about" 这类
  // 带路由前缀的形式，`l.hash` 仍返回 "#about"，因此比较逻辑不变
  const sections = document.querySelectorAll('main section[id]');
  if (sections.length > 0) {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.nav a[href*="#"]')
    );
    const byId = new Map<string, Element>(
      Array.from(sections).map((s) => [`#${s.id}`, s])
    );
    const io = new IntersectionObserver(
      (entries) => {
        let cur: string | null = null;
        for (const e of entries) if (e.isIntersecting) cur = `#${(e.target as HTMLElement).id}`;
        if (cur) {
          links.forEach((l) => l.classList.toggle('is-active', l.hash === cur));
        }
      },
      { rootMargin: '-40% 0px -55% 0px' }
    );
    sections.forEach((s) => io.observe(s));
    void byId;
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    /* 底色 94%（2026-09 作者方案 1）：曾是 88% + 背景毛玻璃滤镜——
       Gecko 下导航条压在每帧重绘的窗外世界 canvas 上，毛玻璃每帧对背后那条带重算高斯模糊
       → 整帧 ~23ms（≈43fps，FF 实测），背景动画肉眼掉帧；Chrome 合成器把这活做得便宜
       所以一直没暴露。去滤镜 + 底色加浓一档：FF 23ms → 6ms（165fps 满帧），观感对齐原玻璃
       （截图对比 nav-B vs nav-E）。守卫：tests/unit/nav-contract.spec.ts「导航禁背景滤镜」。 */
    /* 必须 100% 不透明（2026-10-30 W1·N1）：旧值 94% 让正文从导航底下透出来——
       平暗场上 6% 的亮度差 = ~11 级，4x 截图里能逐字读出文章正文。
       不加背景模糊滤镜：模糊违背像素语言。 */
    background-color: var(--c-bg);
    border-bottom: 1px solid var(--c-line);
    /* 导航是**标识语言的一部分**，全容器走 Zpix。 */
    font-family: var(--font-pixel);
  }

  .nav-inner {
    position: relative; /* 竖排时猫 absolute 定位的参照 */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--nav-height);
  }

  .logo {
    color: var(--c-text);
    font-size: 0.875rem;
    line-height: 20px;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .logo .dot {
    color: var(--c-accent);
  }

  .logo:hover {
    /* 强调色不做文字；hover 通电感靠 2px 强调色下划线 */
    color: var(--c-text);
    text-decoration: underline;
    text-decoration-color: var(--c-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  ul::-webkit-scrollbar {
    display: none;
  }

  a {
    position: relative;
    display: inline-block;
    padding: 0.4rem 0.5rem;
    color: var(--c-text);
    font-size: 0.875rem;
    letter-spacing: var(--ls-14);
    line-height: 20px;
    white-space: nowrap;
    /* 总线（Bus）下划线：8px 档位虚线，hover 通电 */
    border-bottom: 2px dashed color-mix(in srgb, var(--c-accent) 32%, transparent);
    transition: border-color 0.1s steps(2);
  }

  a::after {
    content: '';
    position: absolute;
    right: 0.5rem;
    bottom: 0;
    left: 0.5rem;
    height: 3px;
    background-color: var(--c-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.12s steps(6);
  }

  a:hover {
    /* 文字仍用结构色（accent 作文字在 dawnbringer-ember 4.02 破 AA） */
    color: var(--c-text);
    text-shadow: 2px 2px 0 var(--c-line);
    border-bottom-color: var(--c-accent);
  }

  /* scrollspy 当前 section：靠 3px 实心 accent 下划线（面积变化）区分，
     不靠文字变色——accent 作文字在 dawnbringer-ember 只有 4.02:1。 */
  a.is-active {
    color: var(--c-text);
    border-bottom-color: transparent;
  }

  a.is-active::after {
    transform: scaleX(1);
  }

  /* 窄屏收噪（2026-10-30 W5·S7）：390px 下 7 条 2px 虚线排成一排读作「一排虚线」，
     当前项反而被淹没。窄屏只保留当前项的 3px 实心 accent 下划线。 */
  @media (max-width: 560px) {
    a {
      border-bottom-color: transparent;
    }
  }

  .nav-cat {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav-cat__img {
    width: 60px;
    height: auto;
    image-rendering: pixelated;
  }

  @media (max-width: 560px) {
    .nav-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
      padding-block: 0.5rem;
    }
    ul {
      justify-content: space-between;
    }
    /* 竖排时猫回到板右沿、贴着导航下方，不占整行 */
    .nav-cat {
      position: absolute;
      top: 0.5rem;
      right: 0;
    }
  }
</style>