const MAPS = {
  sleep: [SLEEP_A],
  chase: [CHASE_A, CHASE_B, CHASE_C],
  play: [PLAY_P1, PLAY_P2],
} as const;

interface Props {
  /** 'sleep' = 蜷睡（导航）；'chase' = 奔跑（页脚）；'play' = 打闹（页脚） */
  pose?: keyof typeof MAPS;
  /** 渲染宽度（px），高度按网格比例；由于像素语言限制，必须是网格宽度的整数倍 */
  size?: number;
  /** 无障碍标签；传 '' 表示纯装饰 */
  label?: string;
}

const { pose = 'sleep', size = 28, label } = Astro.props;
const frames = MAPS[pose];
const W = frames[0]![0]!.length;
const H = frames[0]!.length;
const aria =
  label ?? (pose === 'sleep' ? '蜷着睡觉的像素猫' : pose === 'chase' ? '奔跑的像素猫' : '打闹的像素猫');
---

<span class="cat" data-pose={pose} aria-hidden={label === '' ? 'true' : undefined}>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    width={size}
    height={Math.round((size * H) / W)}
    role={label === '' ? undefined : 'img'}
    aria-label={label === '' ? undefined : aria}
    shape-rendering="crispEdges"
  >
    {
      frames.map((frame, k) => (
        <g class="frame" data-frame={k}>
          {frame.map((row, y) =>
            [...row].map((cell, x) =>
              cell === '.' ? null : (
                <rect
                  x={x}
                  y={y}
                  width={1}
                  height={1}
                  fill={PALETTE[cell as keyof typeof PALETTE]}
                />
              )
            )
          )}
        </g>
      ))
    }
  </svg>
</span>

<script>
  // 单一种子 Silk（ap-motion-vocab）——与全站动效同人格；换帧用 steps（离散，不插值）
  const SILK = 'cubic-bezier(0.22, 0.9, 0.24, 1)';

  // 生成第 k 帧在 [k/n, (k+1)/n) 可见的多帧 opacity 硬切关键帧
  const frameKeyframes = (k: number, n: number, on = 1, off = 0) => {
    if (n <= 1) return [{ opacity: on }, { opacity: on }] as any;
    const keys: any[] = [
      { opacity: on, offset: k / n },
      { opacity: on, offset: (k + 1) / n },
      { opacity: off, offset: (k + 1) / n },
      { opacity: off, offset: 1 },
    ];
    // 首帧在 offset 0 即显示；末帧补 1。避免首尾插值
    if (k === 0) keys.unshift({ opacity: on, offset: 0 });
    return keys;
  };

  const start = (cat: HTMLElement) => {
    if (cat.dataset.playing === '1') return;
    cat.dataset.playing = '1';

    const svg = cat.querySelector('svg') as HTMLElement | null;
    if (!svg) return;
    const frames = Array.from(cat.querySelectorAll('.frame')) as HTMLElement[];
    const pose = cat.dataset.pose as string;
    const n = frames.length;
    if (n <= 1) return;

    // 睡猫：两帧呼吸，周期 2.4s（2000–4000ms 区间），每帧 1200ms，opacity 硬切
    const dur = pose === 'sleep' ? 2400 : pose === 'chase' ? 360 : 440;

    frames.forEach((g, k) => {
      g.animate(frameKeyframes(k, n), {
        duration: dur,
        iterations: Infinity,
        easing: 'steps(1)',
      });
    });
  };

  const cats = Array.from(document.querySelectorAll<HTMLElement>('.cat'));
  if (!('IntersectionObserver' in window)) {
    cats.forEach(start); // 无 IO：直接播
  } else {
    // 只在进入视口时播（continuous-infinite 反模式：不在用户看不见时白烧 CPU）
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) start(e.target as HTMLElement);
        }
      },
      { threshold: 0.1 }
    );
    cats.forEach((c) => io.observe(c));
  }
</script>

<style>
  /* 丝印层：裸色落在父容器底色上，无边框无背景（不假装是元件） */
  .cat {
    display: inline-flex;
    line-height: 0;
  }

  svg {
    image-rendering: pixelated;
  }

  /* 多帧姿态：非首帧默认隐藏，由 WAAPI 切 opacity */
  .frame[data-frame]:not([data-frame='0']) {
    opacity: 0;
  }
</style>
