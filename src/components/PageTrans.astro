---
/**
 * PageTrans —— CRT 光束扫屏（像素本体 v3 单签名转场；08-27 作者定稿 FINE）。
 *
 * 机制：劫持站内链接 → 播放「出场幕帘」盖住旧页 → window.location 跳转 →
 * 新页加载后播放「入场幕帘」揭开（sessionStorage 传递标志，避免误播）。
 *
 * 视觉（作者多轮grill拍板：弃 P 系，像素本体 + 电子感，零闪烁；08-28 深优验收定稿）：
 * - 光束永远向下扫：出场（关机）深色幕布锚顶 0→满，光束贴下缘下扫、上方随暗；
 *   入场（开机）幕布锚底 满→0，光束贴上缘下扫、上方随光束点亮新页。
 * - 幕布 = 恒定暗场（gb-0 暗化 30%，13 主题统一“关机黑屏”读感）+ CRT 细扫描线。
 * - 光束 = 双芯：白热亮芯（3px）+ 强调色磷光晕（--gb-2）+ 辉光；无尾迹（拖影已否决）。
 * - 运动 = WAAPI steps() 整齿阶跃（齿高 16px），高度恒为齿的整数倍 = 永远对格；
 *   变齿分段：出慢起步后加速盖满（前 50% 时间走 35% 齿）/ 入快起步后减速揭幕（前 50% 走 65% 齿）。
 * - 时长：出 ≤0.34s / 入 ≤0.28s。覆盖因子 1.3（抗转屏中段露缝）；极小屏缩齿+光束 8px 封底。
 *   收尾干净停住，无负片闪、无抖动、无推镜。
 *
 * 约定：单签名形态，无形态循环按钮、无偏好键（常开零 UI）；
 * 仅劫持站内普通导航；修饰键放行；不设 prefers-reduced-motion 门禁
 * （作者系统开着 reduce，装饰性转场按其意愿全时播放；.ptrans-host 已豁免全局 reduce）。
 * WAAPI 免疫 global.css 的 transition 0.01ms !important 覆盖（v2 ZOOM 修复史同因）。
 */
---

<div id="ptrans-host" class="ptrans-host" aria-hidden="true"></div>

<script>
  import {
    TRANS,
    toothForHeight,
    beamHeightFor,
    curtainHeightFor,
    curtainSteps,
    curtainKeyframes,
  } from '../lib/trans-math';

  const host = document.getElementById('ptrans-host')!;
  const FLAG = '8bitme:pt'; // sessionStorage 换页交接标志
  let busy = false;
  let anis: Animation[] = [];

  function accent(): string {
    return (
      getComputedStyle(document.documentElement).getPropertyValue('--gb-2').trim() || '#ffa300'
    );
  }

  /** 出：幕布锚顶 0→hFull（光束随下缘下扫、上方变暗）；入：幕布锚底 hFull→0（光束随上缘下扫、上方点亮） */
  function build(dir: 'out' | 'in'): void {
    host.replaceChildren();
    const H = innerHeight;
    const acc = accent();
    // 极小屏钳制：齿高 ≤ min(TOOTH, max(8, H/24))，永远整齿对格；光束随齿等比缩放、8px 封底
    const t = toothForHeight(H);
    const beamH = beamHeightFor(t);
    // hFull 对齐齿网格：整齿步进、永远对格；×COVER 抗转屏中段露缝
    const hFull = curtainHeightFor(H, t);
    const steps = curtainSteps(hFull, t);

    const curtain = document.createElement('div');
    curtain.className = 'crt-curtain';
    // 恒定暗场由 is:global CSS 提供（color-mix(gb-0 70%, #000) + 无 color-mix 回退）
    curtain.style.height = dir === 'out' ? '0px' : `${hFull}px`;
    if (dir === 'out') curtain.style.top = '0';
    else curtain.style.bottom = '0';
    host.append(curtain);
    anis.push(
      curtain.animate(curtainKeyframes(dir, hFull, steps, t), {
        duration: dir === 'out' ? TRANS.OUT_DUR : TRANS.IN_DUR,
        fill: 'both',
      })
    );

    // 光束：出 = 幕布下缘（bottom:-beamH）；入 = 幕布上缘（top:-beamH）。双芯 = 白热亮芯 + 色晕
    const beam = document.createElement('div');
    beam.className = 'crt-beam';
    beam.style.height = `${beamH}px`;
    beam.style.background = acc;
    beam.style.boxShadow = `0 0 ${TRANS.GLOW}px ${Math.round(
      TRANS.GLOW / 4
    )}px ${acc}`;
    const core = document.createElement('div');
    core.className = 'crt-core';
    core.style.height = `${TRANS.CORE_H}px`;
    core.style.background = '#fff';
    core.style.boxShadow = '0 0 6px 1px rgba(255,255,255,.5)';
    beam.append(core);
    if (dir === 'out') beam.style.bottom = `-${beamH}px`;
    else beam.style.top = `-${beamH}px`;
    curtain.append(beam);
  }

  function clean(): void {
    anis.forEach((a) => a.cancel());
    anis = [];
    host.replaceChildren();
  }

  function play(dir: 'out' | 'in', onDone?: () => void): void {
    build(dir);
    host.style.pointerEvents = 'auto'; // 动画期拦截连点
    const dur = dir === 'out' ? TRANS.OUT_DUR : TRANS.IN_DUR;
    setTimeout(() => {
      clean();
      host.style.pointerEvents = 'none';
      onDone?.();
    }, dur + 20);
  }

  // ---- 页面加载：入场揭示 ----
  try {
    const flag = sessionStorage.getItem(FLAG);
    if (flag === '1') {
      sessionStorage.removeItem(FLAG);
      play('in');
    }
  } catch {
    /* storage unavailable — ignore */
  }

  // ---- 劫持站内导航 ----
  document.addEventListener('click', (e) => {
    if (busy) return;
    const t = e.target as Element | null;
    const a = t?.closest<HTMLAnchorElement>('a');
    if (!a) return;
    if (e.defaultPrevented) return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
    if (a.target === '_blank' || a.hasAttribute('download')) return;
    const href = a.getAttribute('href') || '';
    if (!href || href.startsWith('#') || /^(mailto|tel|javascript):/i.test(href)) return;
    let url: URL;
    try {
      url = new URL(a.href, location.href);
    } catch {
      return;
    }
    if (url.origin !== location.origin) return;

    e.preventDefault();
    busy = true;
    try {
      sessionStorage.setItem(FLAG, '1');
    } catch {
      /* ignore */
    }
    play('out', () => {
      location.href = url.href;
    });
  });
</script>

<!-- is:global：幕帘元素均在运行时 createElement 生成（无 data-astro-cid），
     带 scope 的规则会全部失配导致转场不可见（曾踩坑） -->
<style is:global>
  .ptrans-host {
    position: fixed;
    inset: 0;
    z-index: 130;
    overflow: hidden;
    pointer-events: none;
  }

  /* ======= CRT 光束扫屏 ======= */
  .ptrans-host .crt-curtain {
    position: absolute;
    left: 0;
    right: 0;
    will-change: height, transform;
    /* 恒定暗场：gb-0 暗化 30%（13 主题统一“关机黑屏”读感；浅色主题不再变浅）
       无 color-mix 回退 = sms-surf 深底 */
    background-color: #1d2b53;
    background-color: color-mix(in srgb, var(--gb-0) 70%, #000);
    /* 深底 + CRT 细扫描线 */
    background-image: repeating-linear-gradient(
      0deg,
      transparent 0 3px,
      rgba(255, 255, 255, 0.07) 3px 4px
    );
  }

  .ptrans-host .crt-beam {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  .ptrans-host .crt-core {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
  }
</style>