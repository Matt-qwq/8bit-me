---
import BaseLayout from '../layouts/BaseLayout.astro';
import WindowScreen from '../components/sections/Window.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Projects from '../components/sections/Projects.astro';
import Skills from '../components/sections/Skills.astro';
import Contact from '../components/sections/Contact.astro';
import SectionFx from '../components/SectionFx.astro';
---

<BaseLayout bgfxHeroVivid>
  {/* 首屏 = 一整扇窗（无字）；站点标题/工位在下一章 #hero（ADR-0027） */}
  <WindowScreen />
  <Hero />
  <About />
  <Projects />
  <Skills />
  <Contact />
  {/* 章节切换·抖动溶解转场（ADR-0026）：只属于一镜到底首页 */}
  <SectionFx />
</BaseLayout>

<script>
  // ── 一镜到底 · 世界常在（docs/plans/home-scroll-reveal-redesign-2026-09.md 候选 A）──
  // 原生连续滚动：不再劫持 wheel/keydown/touch、没有滚动锁、没有子屏翻页与内滚 hack；
  // 锚点导航交给 global.css 的 scroll-behavior: smooth，键盘恢复原生。
  // 章节进场（A4）：IO 阈值 0.2 一次性揭示 —— 标题先行，内容按 STAGGER 依次浮入；
  // **首次揭示后不重放**（Q2：连续滚动下每次进出重放 = 快速滚动闪烁）。
  // 标题扫入（A5）：.section-title 的 2px accent 受光带用 steps() 整齿扫入 ——
  // CRT 全屏光束 DNA 降到元素级；全屏版仍由 PageTrans 独占（跨页签名不动）。
  // 用 WAAPI（非 CSS transition）→ 天然绕过 reduced-motion 的 !important 压制，
  // 与 .ptrans-host 同样按作者意愿豁免；护栏由 tests/e2e/reveal.spec.ts 守。
  import {
    REVEAL,
    REVEAL_PLAN,
    revealDelay,
    sweepKeyframes,
    sweepTeeth,
  } from '../lib/reveal-motion';

  interface Target {
    root: Element;
    els: HTMLElement[];
  }

  const targets: Target[] = [];
  const revealEls: HTMLElement[] = [];

  // 初始全隐藏（避免入场前可见闪烁）；仅 JS 加类，无 JS 时内容默认可见
  for (const p of REVEAL_PLAN) {
    const root = document.querySelector(p.sec);
    if (!root) continue;
    const els: HTMLElement[] = [];
    for (const sel of p.mods)
      root.querySelectorAll(sel).forEach((el) => els.push(el as HTMLElement));
    els.forEach((el) => el.classList.add('reveal-card'));
    revealEls.push(...els);
    if (els.length) targets.push({ root, els });
  }

  const reveal = ({ els }: Target): void => {
    els.forEach((el, i) => {
      // 统一词汇：12px 浮入（幅度/stagger/时长全在 reveal-motion.ts 常量里）
      el.animate(
        [
          { opacity: 0, transform: `translateY(${REVEAL.DIST}px)` },
          { opacity: 1, transform: 'translateY(0)' },
        ],
        {
          duration: REVEAL.DUR,
          delay: revealDelay(i),
          easing: REVEAL.EASING,
          fill: 'both',
        }
      );
      // 标题位（下标 0 且是 .section-title）：受光带同步整齿扫入。
      // 齿数从**实测宽度**派生（opacity:0 不影响布局，可直接量）。
      if (i === 0 && el.classList.contains('section-title')) {
        el.animate(sweepKeyframes(sweepTeeth(el.getBoundingClientRect().width)), {
          duration: REVEAL.DUR,
          fill: 'both',
          pseudoElement: '::after',
        });
      }
    });
  };

  if (!('IntersectionObserver' in window)) {
    revealEls.forEach((el) => el.classList.remove('reveal-card'));
  } else {
    // 一次性揭示：done + unobserve，滚离再回来不重放（Q2）
    const done = new Set<Element>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          // 0.01 容差：阈值穿越帧的浮点比值可能略低于 0.2
          if (!e.isIntersecting || e.intersectionRatio < REVEAL.THRESHOLD - 0.01)
            continue;
          const t = targets.find((x) => x.root === e.target);
          if (!t || done.has(e.target)) continue;
          done.add(e.target);
          io.unobserve(e.target);
          reveal(t);
        }
      },
      { threshold: [0, REVEAL.THRESHOLD] }
    );
    targets.forEach((t) => io.observe(t.root));
  }

  // ── hero 离场视差（A3/Q5）────────────────────────────────────────
  // 铭牌内容做 translateY(−heroTop × 0.3) 正向补偿 = 画面上移变慢（0.7× 净速），
  // 比窗外世界（固定 canvas）之外的一切都「拖后」，离场不再硬跟滚动。
  // **位移基准是这一章自己的位置**（ADR-0027：hero 已是第二屏）：
  // 旧式写的是 `scrollY × 0.3`，那是「首屏从文档顶开始滚」的位移量，
  // 搬到第二屏后会变成「一进屏就被推下去一截」。
  // **transform 只许挂在铭牌的内容元素（.hero-text / .hero-status / .hero-live），
  // 绝不能挂 .hero-inner 自己**：它下面还有两个 position:fixed 的工位层
  // （.hero-scene / .hero-cta）——祖先一挂 transform，fixed 后代的包含块就被
  // 劫持成铭牌盒，整组卡带/头像当场从桌面塌进左栏（作者 2026-10-01 截图实锤：
  // 卡带飞到右上角 x = plate.left + cartX）。逐个内容元素写同值 transform，
  // 视觉上与挪整个铭牌完全一致。
  // 直接操纵（滚动联动）：rAF + 变化才写、只写 transform；reduce 下保留（方案 A3 口径）。
  // 封顶 = hero 盒内下方余量（.hero 是 overflow:hidden，不封顶会把下移的尾行切掉）。
  const heroEl = document.querySelector<HTMLElement>('#hero');
  const heroInner = heroEl?.querySelector<HTMLElement>('.hero-inner');
  const heroParallaxEls = heroEl
    ? Array.from(
        heroEl.querySelectorAll<HTMLElement>('.hero-text, .hero-status, .hero-live')
      )
    : [];
  if (heroEl && heroInner && heroParallaxEls.length) {
    let cap = 0;
    const measure = (): void => {
      cap = Math.max(
        0,
        heroEl.clientHeight - (heroInner.offsetTop + heroInner.offsetHeight)
      );
    };
    let raf = 0;
    let last = Number.NaN;
    const tick = (): void => {
      raf = 0;
      const y = Math.max(0, Math.min(-heroEl.getBoundingClientRect().top * REVEAL.HERO_PARALLAX, cap));
      if (y === last) return;
      last = y;
      const tf = y > 0 ? `translateY(${y}px)` : '';
      for (const el of heroParallaxEls) el.style.transform = tf;
    };
    const schedule = (): void => {
      if (!raf) raf = requestAnimationFrame(tick);
    };
    measure();
    tick();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      schedule();
    });
    document.fonts?.ready.then(() => {
      measure();
      schedule();
    });
  }
</script>
