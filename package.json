{
  "name": "8bit-me",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "sync": "astro sync",
    "typecheck": "astro sync && tsc --noEmit",
    "build": "node scripts/subset-font.mjs && astro build",
    "preview": "node scripts/preview.mjs",
    "astro": "astro",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "astro": "^7.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "fontkit": "^2.0.4",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild": true
  }
}
